# Copie para .env e ajuste os valores. Nunca faça commit de .env.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — leave empty for SQLite (db.sqlite3). Required in production (config.settings.prod).
# DATABASE_URL=postgresql://greenn:greenn@127.0.0.1:5432/greenn_people
DATABASE_URL=

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# E-mail
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@greenn.com.br
NOTIFICATION_REMINDER_DAYS=3
