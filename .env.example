# Copie para .env e ajuste os valores. Nunca faça commit de .env.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — leave empty for SQLite (db.sqlite3). Required in production (config.settings.prod).
# DATABASE_URL=postgresql://greenn:greenn@127.0.0.1:5432/greenn_people
DATABASE_URL=

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# E-mail
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@greenn.com.br
# URL pública da app (links de CTA em e-mails; Celery não tem request).
PUBLIC_BASE_URL=http://localhost:8000
NOTIFICATION_REMINDER_DAYS=3

# Segurança (dev — produção: ver config.settings.prod)
REGISTRATION_ENABLED=True
SESSION_COOKIE_AGE=43200
PASSWORD_RESET_TIMEOUT=3600
# HEALTH_CHECK_TOKEN=  # opcional; se definido, exige X-Health-Token ou ?token=
# Rate limits (tentativas / período em segundos)
# RATE_LIMIT_LOGIN=5
# RATE_LIMIT_LOGIN_PERIOD=60
# RATE_LIMIT_PASSWORD_RESET=3
# RATE_LIMIT_PASSWORD_RESET_PERIOD=300
# RATE_LIMIT_REGISTER=3
# RATE_LIMIT_REGISTER_PERIOD=3600
# RATE_LIMIT_RESEND_CONFIRMATION=3
# RATE_LIMIT_RESEND_CONFIRMATION_PERIOD=300
